# ---------------------------------------------------------------------------
# Production backend.env  (copy to `backend.env` on the VPS, fill in secrets)
# Used by the `backend` service in docker-compose.prod.yml
# ---------------------------------------------------------------------------
APP_NAME=Ideeenbord
APP_ENV=production
APP_KEY=                      # php artisan key:generate --show  (base64:...)
APP_DEBUG=false
APP_URL=https://api.ideeenbord.nl
APP_FRONTEND_URL=https://ideeenbord.nl

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (points at the `db` service in the compose network) ----------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ideeenbord
DB_USERNAME=ideeenbord
DB_PASSWORD=                  # must match DB_PASSWORD in the root .env

# --- Sessions / Sanctum -----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.ideeenbord.nl
SANCTUM_STATEFUL_DOMAINS=ideeenbord.nl,www.ideeenbord.nl

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@ideeenbord.nl"
MAIL_FROM_NAME="Ideeënbord"

# --- Optional S3-compatible storage ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- AI (report generation, seeding, etc.) ---------------------------------
# Provider: claude | openai
AI_PROVIDER=claude
AI_REPORT_MODEL=claude-opus-4-8
AI_SEED_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# AI content bots (Seed/Interactie AI)
AI_BOTS_ENABLED=false
AI_SEED_BRANDS_PER_DAY=5
AI_SEED_IDEAS_PER_BRAND=2
