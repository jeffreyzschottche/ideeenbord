# ---------------------------------------------------------------------------
# Production frontend.env  (copy to `frontend.env` on the VPS)
# Used by the `frontend` service in docker-compose.prod.yml
# ---------------------------------------------------------------------------
# Public base URL of the Laravel API
NUXT_PUBLIC_API_BASE_URL=https://api.ideeenbord.nl

# Canonical site URL (SEO meta, sitemap, JSON-LD)
NUXT_PUBLIC_SITE_URL=https://ideeenbord.nl

# ---------------------------------------------------------------------------
# Google AdSense (publieke pagina's)
# ---------------------------------------------------------------------------
# Aan/uit: "1" = advertenties tonen, "0" = niets tonen (script wordt dan ook niet geladen)
NUXT_PUBLIC_ADSENSE_ENABLED=0
# Je AdSense publisher-id (uit je AdSense-account), bv. ca-pub-1234567890123456
NUXT_PUBLIC_ADSENSE_CLIENT=
# Standaard ad-slot id voor <AdBanner /> zonder expliciete ad-slot prop
NUXT_PUBLIC_ADSENSE_SLOT=
