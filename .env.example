# ---------------------------------------------------------------------------
# Root .env for docker-compose.prod.yml  (copy to `.env` on the VPS)
# Holds the MySQL credentials + which images/ports the stack uses.
# ---------------------------------------------------------------------------

# Image references (must match what GitHub Actions pushes to GHCR)
BACKEND_IMAGE=ghcr.io/jeffreyzschottche/ideeenbord-backend
FRONTEND_IMAGE=ghcr.io/jeffreyzschottche/ideeenbord-frontend
IMAGE_TAG=latest

# Host ports (point your reverse proxy / Caddy / Traefik at these)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# MySQL credentials (DB_PASSWORD must match backend.env)
DB_DATABASE=ideeenbord
DB_USERNAME=ideeenbord
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
